# Configuration of the WireTerm server for development (docker-compose.yml).
# Everything is described in README.md, section "Environment variables".
# Secrets marked with `_FILE` can also be read from a file: set e.g.
# BETTER_AUTH_SECRET_FILE=/run/secrets/auth instead of BETTER_AUTH_SECRET.

# ---- Server ------------------------------------------------------------------
# Defaults: 0.0.0.0 and 80. Here 8080, as published by docker-compose.yml.
SERVER_PORT=8080
# fatal, error, warn, info (default, logs every request), debug, trace, silent
LOG_LEVEL=info
# The API documentation under /documentation. Off unless `true`.
API_DOCS=true
# Who sits in front of the server and may set X-Forwarded-For. Empty: nobody,
# the address of the connection counts. Behind exactly one reverse proxy: 1.
# Otherwise `true`, a number of hops, or addresses/networks, comma-separated.
TRUST_PROXY=
# Requests per minute and address, then 429. Default 600.
RATE_LIMIT_MAX=

# ---- Database (_FILE) ----------------------------------------------------------
# The only connection setting; the server and `prisma migrate` both read it.
# Special characters in the password must be percent-encoded.
DATABASE_URL=mysql://wireterm:wireterm@wireterm_db:3306/wireterm
# `true`: TLS to the database, with certificate verification.
DATABASE_SSL=false
# CA certificate (PEM file) for a database whose CA is not in the system store.
DATABASE_SSL_CA=
# Size of the connection pool, default 5.
DATABASE_CONNECTION_LIMIT=

# ---- Accounts ------------------------------------------------------------------
# Public address of this server: verification links, password reset and
# invitation pages live under it; in WireCloud mode it is also the instance's
# identifier there. Required.
PUBLIC_URL=http://localhost:8080
# Required, at least 32 characters (_FILE).
BETTER_AUTH_SECRET=please-replace-at-least-32-characters
# Required (_FILE).
COOKIE_SECRET=please-replace
# Browser origins that may call the backend, comma-separated. Empty: none —
# the desktop client sends no Origin and is not affected; a web frontend is.
CORS_ORIGIN=http://localhost:5173,http://localhost:1420
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:1420
# Development only: skips better-auth's origin check.
BETTER_AUTH_DISABLE_ORIGIN_CHECK=1
BETTER_AUTH_DISABLE_SIGNUP=0
# Empty: the session cookie belongs to this host only.
BETTER_AUTH_COOKIE_DOMAIN=localhost
# Only for a web frontend of your own: links in mails then point there instead
# of to this server's pages. Leave empty otherwise.
APP_LINK_BASE=

# ---- Mail ----------------------------------------------------------------------
# Without SMTP_HOST no invitations, password links or verification mails go
# out. In docker-compose maildev catches every mail; UI at http://localhost:8082.
SMTP_HOST=wireterm_maildev
SMTP_PORT=1025
# `true`: TLS from the first byte (port 465). Empty: follows the port.
SMTP_SECURE=
SMTP_USERNAME=
# _FILE
SMTP_PASSWORD=
SMTP_TLS_SERVERNAME=
# Sender, e.g. `WireTerm <noreply@example.com>`. Empty: SMTP_USERNAME.
SMTP_FROM=WireTerm <noreply@wireterm.test>

# ---- OpenTelemetry -------------------------------------------------------------
# Without an endpoint nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=wireterm-backend
# Standard OpenTelemetry resource attributes, comma-separated.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development

# ---- WireCloud mode ------------------------------------------------------------
# Sign-in: `local` (default) with accounts of its own, or `wirecloud`, in which
# case the sign-in comes as a token from WireCloud (see README.md, section
# "WireCloud mode"). Against the hosted WireCloud nothing else is needed.
AUTH_MODE=local
# Only for a WireCloud of your own or in development, where it runs next to
# this one: WireCloud as clients reach it (default https://api.cloud.wirecore.net) …
WIRECLOUD_URL=
# … and the issuer in its tokens, where this server also fetches the keys
# (default WIRECLOUD_URL). In the shared Docker network: http://wirecloud_backend:8080
WIRECLOUD_ISSUER=
# This instance's identifier in WireCloud, if not PUBLIC_URL.
WIRECLOUD_AUDIENCE=
