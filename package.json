{
	"name": "wireterm-backend",
	"version": "1.0.1",
	"description": "Synchronizes WireTerm workspaces between devices without being able to read the credentials in them.",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"test": "vitest run --coverage",
		"lint": "eslint .",
		"postinstall": "prisma generate",
		"dev": "tsx watch src/server.ts .env | pino-pretty --colorize",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-templates.mjs",
		"typecheck": "tsc --noEmit",
		"openapi": "tsx scripts/openapi.ts",
		"format": "prettier --write src test scripts *.json *.ts *.js *.md",
		"format:check": "prettier --check src test scripts *.json *.ts *.js *.md"
	},
	"author": "WireCore GmbH",
	"license": "AGPL-3.0-only",
	"dependencies": {
		"@better-auth/api-key": "^1.7.14",
		"@fastify/cookie": "^11.1.3",
		"@fastify/cors": "^11.3.1",
		"@fastify/helmet": "^13.2.0",
		"@fastify/otel": "^0.21.3",
		"@fastify/rate-limit": "^11.2.2",
		"@fastify/swagger": "^9.9.2",
		"@fastify/view": "^12.0.1",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
		"@opentelemetry/instrumentation-http": "^0.223.0",
		"@opentelemetry/instrumentation-pino": "^0.69.0",
		"@opentelemetry/resources": "^2.12.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@opentelemetry/sdk-node": "^0.223.0",
		"@prisma/adapter-mariadb": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@prisma/instrumentation": "^7.10.1",
		"@scalar/fastify-api-reference": "^1.76.0",
		"better-auth": "^1.7.14",
		"dotenv": "^18.0.9",
		"fastify": "^5.12.7",
		"jose": "^6.2.3",
		"nodemailer": "^10.2.1",
		"nunjucks": "^3.2.4",
		"prisma": "^7.10.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@mermaid-js/mermaid-cli": "^12.0.0",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.1",
		"@types/nunjucks": "^3.2.6",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-security": "^4.2.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"prisma-erd-generator": "^3.2.1",
		"tsc-alias": "^1.9.9",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"katex": "^0.18.11",
		"prisma-erd-generator": {
			"@mermaid-js/mermaid-cli": "$@mermaid-js/mermaid-cli"
		},
		"minimatch": "^11.0.4"
	}
}
