<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Reset your password</title>
	</head>
	<body
		style="
			margin: 0;
			padding: 48px 24px;
			font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
			color: #1c1c1e;
			background: #f5f5f7;
		"
	>
		<main
			style="
				max-width: 420px;
				margin: 0 auto;
				padding: 32px;
				background: #fff;
				border-radius: 12px;
			"
		>
			{% if state == 'done' %}
			<h1 style="font-size: 20px; margin: 0 0 16px">Password changed</h1>
			<p style="margin: 0 0 16px; line-height: 1.5">You can sign in with the new password in WireTerm now. This window can be closed.</p>
			{% elif state == 'invalid' %}
			<h1 style="font-size: 20px; margin: 0 0 16px">Set a new password</h1>
			<p style="margin: 0 0 16px; padding: 12px; background: #fdecea; border-radius: 6px; line-height: 1.5">This link is invalid or has expired. Request a new one in WireTerm.</p>
			{% else %}
			<h1 style="font-size: 20px; margin: 0 0 16px">Set a new password</h1>
			<p style="margin: 0 0 16px; line-height: 1.5">Choose a new sign-in password for your WireTerm account.</p>
			{% if state == 'mismatch' %}
			<p style="margin: 0 0 16px; padding: 12px; background: #fdecea; border-radius: 6px; line-height: 1.5">The two passwords are not the same.</p>
			{% elif state == 'length' %}
			<p style="margin: 0 0 16px; padding: 12px; background: #fdecea; border-radius: 6px; line-height: 1.5">The password is too short or too long.</p>
			{% endif %}
			<form method="post">
				<label>
					New password
					<input type="password" name="password" required autocomplete="new-password" style="display: block; width: 100%; box-sizing: border-box; padding: 10px; margin: 6px 0 16px; border: 1px solid #c7c7cc; border-radius: 6px; font: inherit" />
				</label>
				<label>
					Repeat password
					<input type="password" name="repeat" required autocomplete="new-password" style="display: block; width: 100%; box-sizing: border-box; padding: 10px; margin: 6px 0 16px; border: 1px solid #c7c7cc; border-radius: 6px; font: inherit" />
				</label>
				<button type="submit" style="padding: 10px 18px; background: #1c1c1e; color: #fff; border: 0; border-radius: 6px; font: inherit; cursor: pointer">Save password</button>
			</form>
			<p style="margin: 24px 0 0; line-height: 1.5; padding: 12px; background: #fff6e5; border-radius: 6px"><strong>Your master password is not affected.</strong> It is a different password and is stored nowhere on the server — without it your saved credentials stay encrypted.</p>
			{% endif %}
		</main>
	</body>
</html>
