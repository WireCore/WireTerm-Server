// WireTerm backend.
//
// Two halves: the tables better-auth requires (accounts, sessions,
// organizations, teams, invitations), and the tree from the desktop client's
// `workspaces.json`. They are joined in one place — an organization is a
// workspace. What the client today creates locally as a workspace is here the
// organization people are invited to; the projects in it are shared with
// teams.
//
// The server sees everything about the connections except the secret: host,
// port and user name are in plain text, the private key or the password only
// as ciphertext in `Secret`. It is wrapped and unwrapped in the client — see
// README.md, section "Encryption".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The generated files import each other with `.js` instead of `.ts`: tsc
  // writes the extension unchanged to dist/, and there is only .js there.
  // tsx and vitest resolve `.js` to the .ts file during development.
  importFileExtension = "js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.md"
}

datasource db {
  provider = "mysql"
}

// ---- better-auth ------------------------------------------------------------
// Generated by `npx @better-auth/cli generate`. The only changes are what is
// marked with "WireTerm" below.

model User {
  id            String       @id
  name          String       @db.Text
  email         String
  emailVerified Boolean      @default(false)
  image         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  teamMembers   TeamMember[]
  /// `additionalFields` in `src/lib/auth.ts`: the language of this account's
  /// mails (`en`, `de`); empty means the default.
  locale        String?      @db.Text

  // WireTerm
  key             UserKey?
  recoveryKeys    RecoveryKey[]
  projectKeys     ProjectKey[]  @relation("ProjectKeyHolder")
  grantedKeys     ProjectKey[]  @relation("ProjectKeyGranter")
  createdProjects Project[]
  trustedHostKeys KnownHostKey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @db.Text
  /// WireTerm: comes from the organization plugin as soon as teams are enabled.
  activeTeamId         String?  @db.Text

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  /// The sign-in password, hashed by better-auth. Not to be confused with the
  /// master password: that is stored nowhere, not even as a hash.
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Apikey {
  id                  String    @id
  configId            String    @db.Text
  name                String?   @db.Text
  start               String?   @db.Text
  referenceId         String    @db.Text
  prefix              String?   @db.Text
  key                 String    @db.Text
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?   @db.Text
  metadata            String?   @db.Text

  @@index([configId(length: 191)])
  @@index([referenceId(length: 191)])
  @@index([key(length: 191)])
  @@map("apikey")
}

/// Also a workspace. A user who is in several organizations sees several
/// workspaces in the client — the same list that `workspaces_load` reads from
/// the file today.
model Organization {
  id          String       @id
  name        String       @db.Text
  slug        String
  logo        String?      @db.Text
  createdAt   DateTime
  metadata    String?      @db.Text
  members     Member[]
  invitations Invitation[]
  teams       Team[]

  // WireTerm
  /// Monotonically increasing, raised on every change to anything in this
  /// workspace. Every changed row carries the value the counter had at that
  /// moment. `GET /sync?since=N` therefore returns exactly what has happened
  /// since — instead of the whole document that `workspaces_load` reloads
  /// today.
  revision   BigInt         @default(0)
  projects   Project[]
  vaults     VaultAccount[]
  knownHosts KnownHostKey[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `owner`, `admin` or `member` — the roles of the organization plugin.
  /// Owners and admins get at every project of the organization; for everyone
  /// else `ProjectShare` decides.
  role           String       @db.Text
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.Text
  role           String?      @db.Text
  /// WireTerm: set when inviting directly into a team.
  teamId         String?      @db.Text
  status         String       @db.Text
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email(length: 191)])
  @@map("invitation")
}

model Team {
  id             String       @id
  name           String       @db.Text
  /// Kept up to date by the organization plugin itself.
  memberCount    Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?

  members TeamMember[]
  shares  ProjectShare[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id     String @id
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `teamId:userId`, set by better-auth so that the same user does not end
  /// up twice in the same team.
  membershipKey String?   @unique @db.VarChar(191)
  createdAt     DateTime?

  @@index([teamId])
  @@index([userId])
  @@map("team_member")
}

// ---- Key material -----------------------------------------------------------
//
// Nothing here is readable by the server. It keeps ciphertexts and public keys
// and hands them out to whoever is signed in — what turns them into a secret
// happens in the client.

/// A user's key pair. The public part is stored in plain text, because
/// everyone who wants to share a project with this user needs it. The private
/// part is stored wrapped twice: here under the master password, and in
/// [RecoveryKey] under one recovery code each.
model UserKey {
  userId              String   @id
  /// `x25519` — the algorithm of the key pair.
  algorithm           String   @default("x25519") @db.VarChar(64)
  publicKey           Bytes    @db.VarBinary(64)
  /// What the private key was wrapped with.
  wrapAlgorithm       String   @default("xchacha20poly1305") @db.VarChar(64)
  nonce               Bytes    @db.VarBinary(32)
  encryptedPrivateKey Bytes    @db.Blob
  /// How the master password becomes a key. The parameters are stored next to
  /// it so that they can be raised without locking out existing accounts:
  /// whoever signs in computes with what is stored here.
  kdf                 String   @default("argon2id") @db.VarChar(64)
  kdfSalt             Bytes    @db.VarBinary(32)
  /// JSON, e.g. `{"m":65536,"t":3,"p":4}`.
  kdfParams           String   @db.VarChar(255)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_key")
}

/// A recovery code under which the same private key is stored wrapped once
/// more. Whoever loses their master password signs in normally (the sign-in
/// password is a different one), enters a code, unwraps their private key
/// with it and sets a new master password.
///
/// The code itself is stored nowhere — not even as a hash, because a hash
/// would be a point of attack for exactly the database that is not supposed to
/// be able to read anything here. It is recognized by [label].
model RecoveryKey {
  id                  String    @id @default(uuid())
  userId              String
  /// The first group of the code in plain text, so that the client finds the
  /// matching row without having to try them all. Of the roughly 120 bits of
  /// the code this gives away 20; the remaining 100 carry it.
  label               String    @db.VarChar(16)
  wrapAlgorithm       String    @default("xchacha20poly1305") @db.VarChar(64)
  nonce               Bytes     @db.VarBinary(32)
  encryptedPrivateKey Bytes     @db.Blob
  kdf                 String    @default("argon2id") @db.VarChar(64)
  kdfSalt             Bytes     @db.VarBinary(32)
  kdfParams           String    @db.VarChar(255)
  /// A code is valid once. After the recovery the client creates a new set,
  /// because the old one opens the old private key.
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_key")
}

// ---- The tree from workspaces.json -----------------------------------------

/// `onePasswordAccount` and `bitwarden` from the workspace, combined: both
/// answer the same question — which account the connections' references are
/// resolved with. One more provider is one more line in the enum.
model VaultAccount {
  id                String        @id @default(uuid())
  organizationId    String
  provider          VaultProvider
  /// 1Password: the account name. Bitwarden: the email address. The vault's
  /// master password is not stored here either.
  account           String        @default("") @db.VarChar(255)
  /// Bitwarden only: the self-hosted instance. Empty means Bitwarden itself.
  server            String        @default("") @db.VarChar(255)
  acceptInvalidCert Boolean       @default(false)
  revision          BigInt        @default(0)
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId, revision])
  @@map("vault_account")
}

enum VaultProvider {
  onePassword
  bitwarden
}

/// A named folder — and the unit that is shared. The projects of an
/// organization do not automatically belong to everyone: whoever is neither
/// owner nor admin only sees what went to one of their teams (or to the whole
/// organization) via [ProjectShare].
model Project {
  id             String   @id
  organizationId String
  name           String   @db.VarChar(255)
  /// The array order from the JSON file.
  position       Int      @default(0)
  createdById    String?
  revision       BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// Tombstone: otherwise a client that has been offline since the deletion
  /// never learns of it.
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  connections  Connection[]
  shares       ProjectShare[]
  keys         ProjectKey[]
  snippets     Snippet[]

  @@index([organizationId, revision])
  @@map("project")
}

/// Who besides owner and admin gets at a project.
model ProjectShare {
  id        String    @id @default(uuid())
  projectId String
  /// Empty means: the whole organization. Otherwise exactly one team.
  teamId    String?
  role      ShareRole @default(editor)
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([teamId])
  @@map("project_share")
}

enum ShareRole {
  editor
  viewer
}

/// The project key, wrapped for exactly one user.
///
/// The key itself — one per project — is what the secrets in it are wrapped
/// with. It is generated in the client and only leaves it wrapped: with the
/// public key of whoever is to receive it. The server can therefore record a
/// share, but not grant one — only someone who already has the key can wrap
/// it.
model ProjectKey {
  id        String @id @default(uuid())
  projectId String
  userId    String
  /// Which version of the project key. Changes when re-encrypting after a
  /// revocation; old secrets point to the old one until then.
  keyId     String @db.VarChar(64)
  /// `x25519-xchacha20poly1305`.
  algorithm String @default("x25519-xchacha20poly1305") @db.VarChar(64)
  /// The ephemeral public key of the key exchange.
  ephemeralPublicKey Bytes @db.VarBinary(64)
  nonce              Bytes @db.VarBinary(32)
  wrappedKey         Bytes @db.VarBinary(255)
  /// Who wrapped it. For traceability only.
  grantedById String?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation("ProjectKeyHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?   @relation("ProjectKeyGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, keyId])
  @@index([userId])
  @@map("project_key")
}

model Connection {
  id         String         @id
  projectId  String
  name       String         @db.VarChar(255)
  type       ConnectionType
  /// Lifts the connection to the top of the tab menu. Deliberately belongs to
  /// the connection and not to the device — whoever opens the workspace sees
  /// the same selection.
  bookmarked Boolean        @default(false)
  position   Int            @default(0)

  /// What the target said about itself at the last sign-in (`RemoteSystem`).
  /// Unknown before the first sign-in, hence optional throughout.
  systemId      String?   @db.VarChar(64)
  systemName    String?   @db.VarChar(128)
  systemVersion String?   @db.VarChar(64)
  systemPretty  String?   @db.VarChar(255)
  systemSeenAt  DateTime?

  revision  BigInt    @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Exactly one of the three is set, matching `type`. Neither Prisma nor a
  /// CHECK can enforce that — it is in `ConnectionService`.
  ssh SshConnection?
  ftp FtpConnection?
  s3  S3Connection?

  secret   Secret?
  snippets Snippet[]

  @@index([projectId])
  @@index([revision])
  @@map("connection")
}

enum ConnectionType {
  ssh
  ftp
  s3
}

// ---- The three connection types --------------------------------------------

model SshConnection {
  connectionId String @id
  host         String @db.VarChar(255)
  port         Int    @default(22)
  user         String @db.VarChar(255)

  authSource SshAuthSource
  /// Only with `keyFile`: a path on the user's device. Travels along, but is
  /// only useful on the machine where the key actually is.
  keyFilePath    String?        @db.VarChar(1024)
  /// Only with `vault` and `vaultPassword`.
  vaultProvider  VaultProvider?
  vaultReference String?        @db.VarChar(1024)
  /// With `inlineKey` and `password` the secret is in `Connection.secret`,
  /// not here.

  /// Where terminal and file browser change to after connecting. Empty = home.
  startPath String @default("") @db.VarChar(1024)

  /// Which other SSH connection of the same workspace the target is reached
  /// through. Without a foreign key: connections are soft-deleted, and the
  /// client reports a vanished jump host when connecting.
  jumpConnectionId String? @db.VarChar(191)
  /// Whether the client forwards its SSH agent to the server.
  agentForwarding  Boolean @default(false)
  /// Port forwards: `[{ kind, bindHost, bindPort, targetHost,
  /// targetPort }]`, `kind` from `local|remote|dynamic`. `null` for rows from
  /// before the column; a list is always written.
  forwards         Json?
  /// Deviates from the device's default proxy: `{ mode: "direct" }` or
  /// `{ mode: "custom", kind: "socks5"|"http", host, port }`, without auth.
  /// `null` means: the default proxy of the connecting device.
  proxy            Json?
  /// A locked snippet that applies to this connection and is sent in the
  /// terminal after connecting. Without a foreign key, like
  /// `jumpConnectionId`; the snippet routes keep it valid.
  startupSnippetId String? @db.VarChar(191)

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("ssh_connection")
}

/// `vault` is a private key from the vault, `vaultPassword` a password from
/// it; `password` a fixed password that, like `inlineKey`, is stored in
/// `Connection.secret`; `prompt` asks when connecting; `agent` signs in via
/// the local SSH agent.
enum SshAuthSource {
  inlineKey
  keyFile
  vault
  password
  vaultPassword
  prompt
  agent
}

model FtpConnection {
  connectionId String @id
  host         String @db.VarChar(255)
  /// 21 for plain text and explicit FTPS, 990 for implicit.
  port         Int    @default(21)
  user         String @db.VarChar(255)

  authSource     FtpAuthSource
  vaultProvider  VaultProvider?
  vaultReference String?        @db.VarChar(1024)

  security FtpSecurity @default(explicit)
  /// Passive is what works behind NAT, so almost everywhere.
  passive           Boolean @default(true)
  acceptInvalidCert Boolean @default(false)

  /// Where the file browser changes to after connecting. Empty = home.
  startPath String @default("") @db.VarChar(1024)

  /// As with `SshConnection.proxy`.
  proxy Json?

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("ftp_connection")
}

enum FtpAuthSource {
  anonymous
  password
  vault
  prompt
}

enum FtpSecurity {
  plain
  explicit
  implicit
}

model S3Connection {
  connectionId String @id
  /// The endpoint without scheme.
  host         String @db.VarChar(255)
  port         Int    @default(443)
  /// The access key ID — the name under which every request is signed.
  user         String @db.VarChar(255)

  authSource     S3AuthSource
  vaultProvider  VaultProvider?
  vaultReference String?        @db.VarChar(1024)

  region String @default("us-east-1") @db.VarChar(64)
  /// Empty means: the bucket list is the entry point.
  bucket String @default("") @db.VarChar(255)
  prefix String @default("") @db.VarChar(1024)
  tls    Boolean @default(true)
  pathStyle         Boolean @default(false)
  acceptInvalidCert Boolean @default(false)
  /// `STANDARD`, `GLACIER_IR`, … Empty leaves it to the server.
  storageClass      String  @default("") @db.VarChar(64)

  /// As with `SshConnection.proxy`.
  proxy Json?

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("s3_connection")
}

enum S3AuthSource {
  secret
  vault
  prompt
}

// ---- Secrets ---------------------------------------------------------------

/// The private key from `inlineKey`, the password from `password`, the
/// secret access key from `secret` — at most one per connection.
///
/// As ciphertext that the client wraps and unwraps: otherwise the plain text
/// from `workspaces.json` would merely move from the user's disk into a
/// database that is a target for all users at once. The backend sees bytes.
model Secret {
  connectionId String @id
  /// What it was wrapped with, so that a change of algorithm is possible later.
  algorithm    String @default("xchacha20poly1305") @db.VarChar(64)
  /// Which version of the project key opens it — see [ProjectKey].
  keyId        String @db.VarChar(64)
  nonce        Bytes  @db.VarBinary(32)
  ciphertext   Bytes  @db.MediumBlob

  revision  BigInt    @default(0)
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([revision])
  @@map("secret")
}

// ---- Trusted host keys -----------------------------------------------------

/// Today a `known_hosts` file next to `workspaces.json`, i.e. per device.
/// On the organization instead of the user, so that not every team member
/// answers the same question separately — and because, unlike the file, this
/// can be listed and deleted in the UI (open item in the client's TODO.md).
model KnownHostKey {
  id             String @id @default(uuid())
  organizationId String
  host           String @db.VarChar(255)
  port           Int    @default(22)
  /// `ssh-ed25519`, `rsa-sha2-512`, … Only an entry of the same type
  /// contradicts another.
  algorithm      String @db.VarChar(64)
  /// The public key, base64 as in the file.
  publicKey      String @db.Text

  trustedById String?
  revision    BigInt    @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trustedBy    User?        @relation(fields: [trustedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, host, port, algorithm])
  @@index([organizationId, revision])
  @@map("known_host_key")
}

/// A saved command that the terminal sends at the push of a button — or when
/// connecting, if an SSH connection names it as `startupSnippetId`. It belongs
/// to a project and is seen by whoever sees the project: for all of its
/// connections, or for just one.
///
/// `locked` decides who may change it: locked only owner and admin, otherwise
/// the project's editors as well. Only a locked snippet can be a startup
/// command, because that runs unasked in other people's terminals.
model Snippet {
  /// From the client, as with project and connection.
  id           String    @id @db.VarChar(191)
  projectId    String
  /// Only for this connection of the project; empty means: for all of them.
  connectionId String?   @db.VarChar(191)
  locked       Boolean   @default(true)
  name         String    @db.VarChar(255)
  /// The folder, `/`-separated. Empty means top level.
  folder       String    @default("") @db.VarChar(255)
  /// What is sent, line by line. The client replaces placeholders like
  /// `{{connection.host}}`.
  command      String    @db.Text
  position     Int       @default(0)
  revision     BigInt    @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([projectId, revision])
  @@index([connectionId])
  @@map("snippet")
}

// ---- WireCloud ---------------------------------------------------------------
// In `AUTH_MODE=wirecloud` users, companies and teams come from WireCloud
// (see README.md, section "WireCloud mode"). This table maps the identifier
// at WireCloud to the local one. It changes nothing about better-auth's
// tables: the mapping sits next to them and only points to them.

model ExternalRef {
  id         String   @id @default(uuid())
  /// `user`, `organization` or `team`.
  entityType String   @db.VarChar(16)
  /// Identifier of the local row in `user`, `organization` or `team`. Without
  /// a foreign key, because the target is a different table depending on
  /// `entityType`; the sync detects orphaned rows and cleans them up.
  localId    String   @db.VarChar(191)
  /// The issuer (`iss`) of the tokens the identifier comes from.
  issuer     String   @db.VarChar(255)
  /// Identifier at WireCloud: account (`sub`), company or team.
  externalId String   @db.VarChar(191)
  createdAt  DateTime @default(now())

  @@unique([entityType, issuer, externalId])
  @@index([entityType, localId])
  @@map("external_ref")
}

/// Event from WireCloud that has already been applied (VERTRAG.md 7). Keeps
/// every delivery idempotent (`eventId`) and ordered (`sequence` per company
/// or account): whatever has already been seen or superseded is skipped.
model ExternalEvent {
  id        String   @id @default(uuid())
  issuer    String   @db.VarChar(255)
  eventId   String   @db.VarChar(191)
  /// `company:<id>` or `account:<id>` at WireCloud.
  scopeKey  String   @db.VarChar(191)
  sequence  BigInt
  type      String   @db.VarChar(48)
  appliedAt DateTime @default(now())

  @@unique([issuer, eventId])
  @@index([issuer, scopeKey, sequence])
  @@map("external_event")
}
